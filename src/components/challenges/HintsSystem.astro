---
interface Props {
  hints: string[];
}

const { hints } = Astro.props;
---

<div class="hints-section">
  <h3>Hints</h3>
  <div class="hint-container">
    {hints.map((hint, index) => (
      <div class={`hint ${index === 0 ? '' : 'hidden'}`} data-hint={index + 1}>
        <p>{hint}</p>
      </div>
    ))}
  </div>
  <button class="hint-button" id="revealHint">Reveal Next Hint</button>
</div>

<style>
  .hints-section {
    margin-bottom: 30px;
  }

  .hints-section h3 {
    color: #ffffff;
    margin-bottom: 15px;
  }

  .hint-container {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 15px;
  }

  .hint {
    background: #2d2d2d;
    padding: 15px;
    border-radius: 8px;
    border-left: 4px solid #ff9800;
  }

  .hint.hidden {
    display: none;
  }

  .hint p {
    color: #d4d4d4;
    line-height: 1.6;
  }

  .hint-button {
    width: 100%;
    padding: 12px;
    background: #667eea;
    color: white;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-size: 1em;
    transition: background 0.3s;
  }

  .hint-button:hover:not(:disabled) {
    background: #5568d3;
  }

  .hint-button:disabled {
    background: #3c3c3c;
    cursor: not-allowed;
  }
</style>

<script>
  // Hints system logic
  const hintButton = document.getElementById('revealHint') as HTMLButtonElement | null;
  const hints = document.querySelectorAll('.hint');
  let currentHint = 1;

  if (hintButton) {
    hintButton.addEventListener('click', () => {
      if (currentHint < hints.length) {
        const nextHint = document.querySelector(`.hint[data-hint="${currentHint + 1}"]`);
        if (nextHint) {
          nextHint.classList.remove('hidden');
          currentHint++;
          
          if (currentHint >= hints.length) {
            hintButton.textContent = 'All hints revealed';
            hintButton.disabled = true;
          }
        }
      }
    });
  }
</script>
