    flex: 1;
    display: flex;
    flex-direction: column;
    background: #1e1e1e;
  }

  .challenge-header {
    margin-bottom: 30px;
  }

  .challenge-meta {
    display: flex;
    gap: 10px;
    margin-bottom: 15px;
  }

