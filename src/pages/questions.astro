---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Interview Questions - Learning Hub">
  <div class="container">
    <div class="header">
      <h1>❓ Interview Questions</h1>
      <p>Practice and prepare for frontend developer interviews with comprehensive question banks</p>
    </div>

    <div class="questions-grid">
      <a href="/questions/css" class="question-card">
        <div class="question-icon">🎨</div>
        <h3>CSS & Styling</h3>
        <p>Master CSS fundamentals, layouts, frameworks, and styling best practices</p>
        <div class="question-meta">
          <span class="badge badge-intermediate">Intermediate</span>
          <span class="topic-count">50+ Questions</span>
        </div>
      </a>

      <a href="/questions/html" class="question-card">
        <div class="question-icon">📄</div>
        <h3>HTML & Semantics</h3>
        <p>Master HTML structure, semantics, accessibility, and modern best practices</p>
        <div class="question-meta">
          <span class="badge badge-beginner">Beginner</span>
          <span class="topic-count">40+ Questions</span>
        </div>
      </a>

      <a href="/questions/javascript" class="question-card">
        <div class="question-icon">⚡</div>
        <h3>JavaScript</h3>
        <p>Master JavaScript fundamentals, ES6+, async programming, and modern patterns</p>
        <div class="question-meta">
          <span class="badge badge-advanced">Advanced</span>
          <span class="topic-count">60+ Questions</span>
        </div>
      </a>

      <a href="/questions/react" class="question-card">
        <div class="question-icon">⚛️</div>
        <h3>React</h3>
        <p>Master React concepts, hooks, state management, and best practices</p>
        <div class="question-meta">
          <span class="badge badge-advanced">Advanced</span>
          <span class="topic-count">50+ Questions</span>
        </div>
      </a>

      <a href="/questions/typescript" class="question-card">
        <div class="question-icon">📘</div>
        <h3>TypeScript</h3>
        <p>Master TypeScript types, generics, interfaces, and advanced patterns</p>
        <div class="question-meta">
          <span class="badge badge-intermediate">Intermediate</span>
          <span class="topic-count">40+ Questions</span>
        </div>
      </a>

      <a href="/questions/performance" class="question-card">
        <div class="question-icon">⚡</div>
        <h3>Performance</h3>
        <p>Master web performance optimization, metrics, and best practices</p>
        <div class="question-meta">
          <span class="badge badge-advanced">Advanced</span>
          <span class="topic-count">35+ Questions</span>
        </div>
      </a>

      <a href="/questions/security" class="question-card">
        <div class="question-icon">🔒</div>
        <h3>Security</h3>
        <p>Master web security concepts, vulnerabilities, and protection strategies</p>
        <div class="question-meta">
          <span class="badge badge-advanced">Advanced</span>
          <span class="topic-count">30+ Questions</span>
        </div>
      </a>

      <a href="/questions/system-design-frontend" class="question-card">
        <div class="question-icon">🏗️</div>
        <h3>System Design</h3>
        <p>Master frontend system design, architecture, and scalability patterns</p>
        <div class="question-meta">
          <span class="badge badge-senior">Senior</span>
          <span class="topic-count">25+ Questions</span>
        </div>
      </a>

      <a href="/questions/patterns" class="question-card">
        <div class="question-icon">🧩</div>
        <h3>Design Patterns</h3>
        <p>Master design patterns, rendering patterns, and architectural patterns</p>
        <div class="question-meta">
          <span class="badge badge-advanced">Advanced</span>
          <span class="topic-count">30+ Questions</span>
        </div>
      </a>
    </div>
  </div>
</Layout>

<style>
  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  .header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 60px 20px;
    border-radius: 20px;
    margin-bottom: 40px;
    text-align: center;
  }

  .header h1 {
    font-size: 3em;
    margin-bottom: 15px;
  }

  .header p {
    font-size: 1.2em;
    opacity: 0.9;
  }

  .questions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
  }

  .question-card {
    background: white;
    border-radius: 16px;
    padding: 30px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s, box-shadow 0.3s;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    border: 1px solid #e5e5e5;
  }

  .question-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .question-icon {
    font-size: 3em;
    margin-bottom: 15px;
  }

  .question-card h3 {
    font-size: 1.5em;
    margin-bottom: 10px;
    color: #1d1d1f;
  }

  .question-card p {
    color: #6e6e73;
    line-height: 1.6;
    margin-bottom: 15px;
  }

  .question-meta {
    display: flex;
    gap: 10px;
  }

  .badge {
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 0.85em;
    font-weight: 600;
  }

  .badge-beginner {
    background: #d4edda;
    color: #155724;
  }

  .badge-intermediate {
    background: #fff3cd;
    color: #856404;
  }

  .badge-advanced {
    background: #f8d7da;
    color: #721c24;
  }

  .badge-senior {
    background: #667eea;
    color: white;
  }

  .topic-count {
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 0.85em;
    background: #e3f2fd;
    color: #1976d2;
  }
</style>
