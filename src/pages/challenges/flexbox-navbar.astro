    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 15px;
  }

  .hint {
    background: #2d2d2d;
    padding: 15px;
    border-radius: 8px;
    border-left: 4px solid #ff9800;
  }

  .hint.hidden {
    display: none;
  }

  .hint p {
