---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Hotel Booking Confirmation - Frontend Mentor">
  <div class="hotel-booking">
    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="brand">Maison Soleil</div>
      
      <nav class="guest-nav">
        <div class="nav-item active">Your stay</div>
        <div class="nav-item">1</div>
        <div class="nav-item">The house</div>
        <div class="nav-item">Around town</div>
        <div class="nav-item">Breakfast</div>
        <div class="nav-item">Messages</div>
      </nav>

      <div class="weather">
        <div class="weather-title">Today in Cassis</div>
        <div class="weather-temp">27°</div>
        <div class="weather-desc">Sunny · light breeze</div>
      </div>

      <div class="sidebar-footer">
        <div class="established">Est. 1987</div>
        <div class="address">Maison Soleil · 12 Rue des Oliviers · Cassis</div>
        <div class="copyright">© 2026 Maison Soleil</div>
      </div>
    </aside>

    <!-- Main content -->
    <main class="main-content">
      <div class="booking-header">
        <h1>Booking · Confirmed</h1>
        <p class="welcome">Bienvenue, Lucia.</p>
      </div>

      <div class="actions">
        <button class="action-btn">Print receipt</button>
        <button class="action-btn">Add to calendar</button>
      </div>

      <!-- Booking cards -->
      <div class="booking-cards">
        <!-- Receipt card -->
        <div class="card receipt-card">
          <h2>Receipt</h2>
          <div class="receipt-number">№ MS-2026 0421-AH</div>

          <h3>Your stay</h3>

          <div class="stay-details">
            <div class="detail-row">
              <span class="label">Check in</span>
              <span class="value">25 Apr</span>
            </div>
            <div class="detail-sub">Saturday · 15:00</div>

            <div class="detail-row">
              <span class="label">Check out</span>
              <span class="value">29 Apr</span>
            </div>
            <div class="detail-sub">Wednesday · 11:00</div>

            <div class="detail-row">
              <span class="label">Room · La Garrigue · 4 nights</span>
              <span class="value">€ 620.00</span>
            </div>
            <div class="detail-row">
              <span class="label">Breakfast · 2 guests</span>
              <span class="value">€ 96.00</span>
            </div>
            <div class="detail-row">
              <span class="label">Tourist tax</span>
              <span class="value">€ 14.40</span>
            </div>
          </div>

          <div class="total">
            <span class="total-label">Total paid</span>
            <span class="total-value">€ 730.40</span>
          </div>

          <div class="payment-method">Paid · Wise · GBP</div>
        </div>

        <!-- Note from host card -->
        <div class="card note-card">
          <h2>Welcome</h2>
          <p class="note-subtitle">A note from your host, Margaux.</p>
          <p class="note-text">We're so glad you're coming. The shutters will be open, the lemonade cold, and the cat - Poivre - pretending not to notice you.</p>
          <div class="room-name">Room · La Garrigue</div>
        </div>
      </div>

      <!-- Guest info row -->
      <div class="guest-info">
        <div class="info-card">
          <div class="info-number">01</div>
          <h3>Arrival</h3>
          <p class="info-sub">Check-in from 15:00</p>
          <p class="info-detail">Sat, 25 April</p>
          <p class="info-text">Ring the brass bell by the blue door. If we're at the market, the key is in the terracotta pot by the olive tree.</p>
        </div>

        <div class="info-card">
          <div class="info-number">02</div>
          <h3>Wifi</h3>
          <p class="info-sub">Le Soleil · Guest</p>
          <p class="info-detail">Password below</p>
          <div class="wifi-details">
            <div class="wifi-row">
              <span class="wifi-label">Network</span>
              <span class="wifi-value">Le Soleil · Guest</span>
            </div>
            <div class="wifi-row">
              <span class="wifi-label">Password</span>
              <span class="wifi-value">soleil-2026</span>
            </div>
          </div>
          <button class="copy-btn">Copy</button>
        </div>

        <div class="info-card">
          <div class="info-number">03</div>
          <h3>Breakfast</h3>
          <p class="info-sub">Served 8 - 10:30</p>
          <p class="info-detail">On the terrace</p>
          <p class="info-text">Fresh figs, Marseille honey, pain au levain, and espresso. Gluten-free option? Leave a note the night before.</p>
        </div>
      </div>

      <div class="links">
        <a href="/frontend-mentor" class="back-link">← Back to Frontend Mentor</a>
      </div>
    </main>
  </div>
</Layout>

<style>
  .hotel-booking {
    display: flex;
    min-height: 100vh;
    background: #f5f5f7;
  }

  .sidebar {
    width: 280px;
    background: #fff;
    padding: 40px 30px;
    display: flex;
    flex-direction: column;
    border-right: 1px solid #e5e5e5;
  }

  .brand {
    font-size: 1.5em;
    font-weight: 600;
    color: #1d1d1f;
    margin-bottom: 40px;
  }

  .guest-nav {
    flex: 1;
  }

  .nav-item {
    padding: 12px 0;
    color: #6e6e73;
    cursor: pointer;
    transition: color 0.3s;
  }

  .nav-item:hover,
  .nav-item.active {
    color: #1d1d1f;
    font-weight: 500;
  }

  .weather {
    margin: 40px 0;
    padding: 20px 0;
    border-top: 1px solid #e5e5e5;
    border-bottom: 1px solid #e5e5e5;
  }

  .weather-title {
    font-size: 0.9em;
    color: #6e6e73;
    margin-bottom: 8px;
  }

  .weather-temp {
    font-size: 2em;
    font-weight: 600;
    color: #1d1d1f;
  }

  .weather-desc {
    color: #6e6e73;
    margin-top: 4px;
  }

  .sidebar-footer {
    margin-top: auto;
  }

  .established {
    font-size: 0.85em;
    color: #6e6e73;
    margin-bottom: 8px;
  }

  .address {
    font-size: 0.85em;
    color: #6e6e73;
    margin-bottom: 8px;
  }

  .copyright {
    font-size: 0.85em;
    color: #6e6e73;
  }

  .main-content {
    flex: 1;
    padding: 60px 40px;
    max-width: 1200px;
  }

  .booking-header {
    margin-bottom: 40px;
  }

  .booking-header h1 {
    font-size: 2.5em;
    color: #1d1d1f;
    margin-bottom: 10px;
  }

  .welcome {
    font-size: 1.2em;
    color: #6e6e73;
  }

  .actions {
    display: flex;
    gap: 15px;
    margin-bottom: 40px;
  }

  .action-btn {
    padding: 12px 24px;
    background: #1d1d1f;
    color: white;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-size: 1em;
    transition: background 0.3s;
  }

  .action-btn:hover {
    background: #333;
  }

  .booking-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
    margin-bottom: 40px;
  }

  .card {
    background: white;
    border-radius: 16px;
    padding: 30px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .card h2 {
    font-size: 1.5em;
    color: #1d1d1f;
    margin-bottom: 20px;
  }

  .receipt-number {
    font-size: 0.9em;
    color: #6e6e73;
    margin-bottom: 30px;
  }

  .card h3 {
    font-size: 1.2em;
    color: #1d1d1f;
    margin-bottom: 20px;
  }

  .detail-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 12px;
  }

  .label {
    color: #6e6e73;
  }

  .value {
    font-weight: 500;
    color: #1d1d1f;
  }

  .detail-sub {
    font-size: 0.9em;
    color: #6e6e73;
    margin-bottom: 20px;
  }

  .total {
    display: flex;
    justify-content: space-between;
    margin: 30px 0;
    padding-top: 20px;
    border-top: 2px solid #e5e5e5;
  }

  .total-label {
    font-size: 1.2em;
    font-weight: 600;
    color: #1d1d1f;
  }

  .total-value {
    font-size: 1.5em;
    font-weight: 700;
    color: #1d1d1f;
  }

  .payment-method {
    color: #6e6e73;
    font-size: 0.9em;
  }

  .note-subtitle {
    color: #6e6e73;
    margin-bottom: 15px;
  }

  .note-text {
    color: #1d1d1f;
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .room-name {
    font-weight: 600;
    color: #1d1d1f;
  }

  .guest-info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
  }

  .info-card {
    background: white;
    border-radius: 16px;
    padding: 30px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .info-number {
    font-size: 2em;
    font-weight: 700;
    color: #667eea;
    margin-bottom: 15px;
  }

  .info-card h3 {
    font-size: 1.3em;
    color: #1d1d1f;
    margin-bottom: 10px;
  }

  .info-sub {
    color: #6e6e73;
    margin-bottom: 5px;
  }

  .info-detail {
    font-weight: 500;
    color: #1d1d1f;
    margin-bottom: 15px;
  }

  .info-text {
    color: #6e6e73;
    line-height: 1.6;
  }

  .wifi-details {
    margin: 15px 0;
  }

  .wifi-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
  }

  .wifi-label {
    color: #6e6e73;
  }

  .wifi-value {
    font-weight: 500;
    color: #1d1d1f;
  }

  .copy-btn {
    margin-top: 15px;
    padding: 8px 16px;
    background: #667eea;
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.9em;
    transition: background 0.3s;
  }

  .copy-btn:hover {
    background: #5568d3;
  }

  .links {
    margin-top: 40px;
  }

  .back-link {
    display: inline-block;
    padding: 10px 20px;
    background: #f0f0f0;
    border-radius: 8px;
    text-decoration: none;
    color: #333;
    transition: all 0.3s;
  }

  .back-link:hover {
    background: #e0e0e0;
  }

  @media (max-width: 768px) {
    .hotel-booking {
      flex-direction: column;
    }

    .sidebar {
      width: 100%;
      padding: 20px;
    }

    .main-content {
      padding: 30px 20px;
    }

    .booking-cards,
    .guest-info {
      grid-template-columns: 1fr;
    }
  }
</style>
