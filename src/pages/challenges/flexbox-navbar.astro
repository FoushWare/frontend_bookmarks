---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Flexbox Navbar Challenge - Interactive Learning">
  <div class="challenge-container">
    <!-- Left Panel - Learning -->
    <aside class="learning-panel">
      <div class="challenge-header">
        <div class="challenge-meta">
          <span class="challenge-number">Challenge #15</span>
          <span class="difficulty-badge beginner">Beginner</span>
        </div>
        <h1>Flexbox Navbar Challenge</h1>
        <div class="challenge-info">
          <span class="topic-tag">Flexbox</span>
          <span class="time-tag">25 minutes</span>
        </div>
      </div>

      <div class="reference-image">
        <h3>Reference Design</h3>
        <div class="image-placeholder">
          <div class="preview-navbar">
            <div class="preview-logo">🚀 Logo</div>
            <div class="preview-links">
              <span>Home</span>
              <span>About</span>
              <span>Services</span>
              <span>Contact</span>
            </div>
            <div class="preview-actions">
              <span>Login</span>
              <span>Sign Up</span>
            </div>
          </div>
        </div>
      </div>

      <div class="challenge-description">
        <h3>Description</h3>
        <p>Build a responsive navigation bar with a logo, navigation links, and action buttons using Flexbox. The layout should distribute space evenly and align items properly.</p>
      </div>

      <div class="learning-objectives">
        <h3>Learning Objectives</h3>
        <ul>
          <li>Understand Flexbox layout system</li>
          <li>Use justify-content for horizontal alignment</li>
          <li>Use align-items for vertical alignment</li>
          <li>Implement responsive navigation with flex-wrap</li>
        </ul>
      </div>

      <div class="requirements-section">
        <h3>Requirements</h3>
        <div class="progress-bar">
          <div class="progress-fill" style="width: 0%"></div>
        </div>
        <div class="progress-text">0 / 6 completed (0%)</div>
        <div class="requirements-list">
          <label class="requirement-item">
            <input type="checkbox" data-index="0" />
            <span>Use Flexbox</span>
          </label>
          <label class="requirement-item">
            <input type="checkbox" data-index="1" />
            <span>Space between logo and links</span>
          </label>
          <label class="requirement-item">
            <input type="checkbox" data-index="2" />
            <span>Center items vertically</span>
          </label>
          <label class="requirement-item">
            <input type="checkbox" data-index="3" />
            <span>Equal spacing between links</span>
          </label>
          <label class="requirement-item">
            <input type="checkbox" data-index="4" />
            <span>Make responsive</span>
          </label>
          <label class="requirement-item">
            <input type="checkbox" data-index="5" />
            <span>Add hover effects</span>
          </label>
        </div>
      </div>

      <div class="learning-tips">
        <h3>Learning Tips</h3>
        <div class="tip-card">
          <p>Think about which justify-content value creates space between elements while keeping them at the edges.</p>
        </div>
      </div>

      <div class="common-mistakes">
        <h3>Common Mistakes</h3>
        <details class="mistake-card">
          <summary>Forgetting display: flex</summary>
          <p>Always remember to set display: flex on the container before using flexbox properties.</p>
        </details>
        <details class="mistake-card">
          <summary>Using margin instead of gap</summary>
          <p>Modern flexbox supports the gap property for spacing between items, which is cleaner than margins.</p>
        </details>
        <details class="mistake-card">
          <summary>Not handling mobile view</summary>
          <p>Remember to use flex-wrap or media queries to handle navigation on smaller screens.</p>
        </details>
      </div>

      <div class="hints-section">
        <h3>Hints</h3>
        <div class="hint-container">
          <div class="hint" data-hint="1">
            <p>Which justify-content value puts elements at the edges with space between?</p>
          </div>
          <div class="hint hidden" data-hint="2">
            <p>Consider using justify-content: space-between.</p>
          </div>
          <div class="hint hidden" data-hint="3">
            <p>For vertical centering, use align-items: center.</p>
          </div>
          <div class="hint hidden" data-hint="4">
            <p>Add gap to create consistent spacing between items.</p>
          </div>
          <div class="hint hidden" data-hint="5">
            <p>Use flex-wrap for responsive behavior on mobile.</p>
          </div>
        </div>
        <button class="hint-button" id="revealHint">Reveal Next Hint</button>
      </div>

      <div class="stretch-goals">
        <h3>Stretch Goals</h3>
        <ul>
          <li>Add mobile hamburger menu</li>
          <li>Create dropdown menus</li>
          <li>Add smooth scroll behavior</li>
          <li>Implement sticky positioning</li>
          <li>Add active state indicators</li>
        </ul>
      </div>

      <div class="final-solution">
        <button class="final-button" id="showFinal">Show Final Result</button>
      </div>

      <div class="navigation">
        <a href="/frontend_bookmarks/challenges/css-grid-layout" class="nav-button prev">← Previous</a>
        <a href="/frontend_bookmarks/challenges/grid-card-layout" class="nav-button next">Next →</a>
      </div>
    </aside>

    <!-- Right Panel - Code Editor & Preview -->
    <main class="editor-panel">
      <div class="preview-controls">
        <button class="size-button active" data-size="desktop">Desktop</button>
        <button class="size-button" data-size="tablet">Tablet</button>
        <button class="size-button" data-size="mobile">Mobile</button>
      </div>

      <div class="editor-section">
        <div class="editor-tabs">
          <button class="tab-button active" data-tab="html">HTML</button>
          <button class="tab-button" data-tab="css">CSS</button>
        </div>
        <div class="editor-container">
          <textarea id="htmlEditor" class="code-editor" spellcheck="false"><nav class="navbar">
  <div class="logo">🚀 Logo</div>
  <div class="nav-links">
    <a href="#">Home</a>
    <a href="#">About</a>
    <a href="#">Services</a>
    <a href="#">Contact</a>
  </div>
  <div class="nav-actions">
    <a href="#" class="btn-login">Login</a>
    <a href="#" class="btn-signup">Sign Up</a>
  </div>
</nav></textarea>
          <textarea id="cssEditor" class="code-editor hidden" spellcheck="false">.navbar {
  
}

.logo {
  
}

.nav-links {
  
}

.nav-actions {
  
}

.btn-login,
.btn-signup {
  
}</textarea>
        </div>
      </div>

      <div class="preview-section">
        <h3>Live Preview</h3>
        <div class="preview-container" id="previewContainer">
          <iframe id="previewFrame" class="preview-frame"></iframe>
        </div>
      </div>
    </main>
  </div>

  <script>
    // Editor functionality
    const htmlEditor = document.getElementById('htmlEditor');
    const cssEditor = document.getElementById('cssEditor');
    const previewFrame = document.getElementById('previewFrame');
    const previewContainer = document.getElementById('previewContainer');

    // Tab switching
    const tabButtons = document.querySelectorAll('.tab-button');
    tabButtons.forEach(button => {
      button.addEventListener('click', () => {
        tabButtons.forEach(btn => btn.classList.remove('active'));
        button.classList.add('active');
        
        const tab = button.dataset.tab;
        if (tab === 'html') {
          htmlEditor.classList.remove('hidden');
          cssEditor.classList.add('hidden');
        } else {
          htmlEditor.classList.add('hidden');
          cssEditor.classList.remove('hidden');
        }
      });
    });

    // Preview size switching
    const sizeButtons = document.querySelectorAll('.size-button');
    sizeButtons.forEach(button => {
      button.addEventListener('click', () => {
        sizeButtons.forEach(btn => btn.classList.remove('active'));
        button.classList.add('active');
        
        const size = button.dataset.size;
        previewContainer.className = 'preview-container';
        
        switch(size) {
          case 'desktop':
            previewContainer.style.maxWidth = '100%';
            break;
          case 'tablet':
            previewContainer.style.maxWidth = '768px';
            break;
          case 'mobile':
            previewContainer.style.maxWidth = '375px';
            break;
        }
      });
    });

    // Live preview update
    function updatePreview() {
      const html = htmlEditor.value;
      const css = cssEditor.value;
      
      const previewContent = `
        <!DOCTYPE html>
        <html>
        <head>
          <style>
            * { margin: 0; padding: 0; box-sizing: border-box; }
            body { font-family: Arial, sans-serif; padding: 20px; }
            a { text-decoration: none; }
            ${css}
          </style>
        </head>
        <body>
          ${html}
        </body>
        </html>
      `;
      
      previewFrame.srcdoc = previewContent;
    }

    htmlEditor.addEventListener('input', updatePreview);
    cssEditor.addEventListener('input', updatePreview);

    // Initial preview
    updatePreview();

    // Requirements checklist
    const requirementItems = document.querySelectorAll('.requirement-item input');
    const progressFill = document.querySelector('.progress-fill');
    const progressText = document.querySelector('.progress-text');

    requirementItems.forEach(item => {
      item.addEventListener('change', () => {
        const checked = document.querySelectorAll('.requirement-item input:checked').length;
        const total = requirementItems.length;
        const percentage = Math.round((checked / total) * 100);
        
        progressFill.style.width = percentage + '%';
        progressText.textContent = `${checked} / ${total} completed (${percentage}%)`;
      });
    });

    // Hints system
    const hintButton = document.getElementById('revealHint');
    const hints = document.querySelectorAll('.hint');
    let currentHint = 1;

    hintButton.addEventListener('click', () => {
      if (currentHint < hints.length) {
        const nextHint = document.querySelector(`.hint[data-hint="${currentHint + 1}"]`);
        if (nextHint) {
          nextHint.classList.remove('hidden');
          currentHint++;
          
          if (currentHint >= hints.length) {
            hintButton.textContent = 'All hints revealed';
            hintButton.disabled = true;
          }
        }
      }
    });

    // Final solution
    const showFinalButton = document.getElementById('showFinal');
    let finalShown = false;

    showFinalButton.addEventListener('click', () => {
      if (!finalShown) {
        cssEditor.value = `.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px;
  background: #667eea;
  color: white;
  gap: 20px;
}

.logo {
  font-size: 1.5em;
  font-weight: bold;
}

.nav-links {
  display: flex;
  gap: 20px;
}

.nav-links a {
  color: white;
  transition: opacity 0.3s;
}

.nav-links a:hover {
  opacity: 0.8;
}

.nav-actions {
  display: flex;
  gap: 10px;
}

.btn-login,
.btn-signup {
  padding: 8px 16px;
  border-radius: 6px;
  transition: background 0.3s;
}

.btn-login {
  background: transparent;
  border: 2px solid white;
  color: white;
}

.btn-login:hover {
  background: rgba(255, 255, 255, 0.1);
}

.btn-signup {
  background: white;
  color: #667eea;
}

.btn-signup:hover {
  background: #f0f0f0;
}

@media (max-width: 768px) {
  .navbar {
    flex-wrap: wrap;
  }
  
  .nav-links {
    order: 3;
    width: 100%;
    justify-content: center;
    margin-top: 20px;
  }
}`;
        updatePreview();
        showFinalButton.textContent = 'Reset to Starter Code';
        finalShown = true;
      } else {
        cssEditor.value = `.navbar {
  
}

.logo {
  
}

.nav-links {
  
}

.nav-actions {
  
}

.btn-login,
.btn-signup {
  
}`;
        updatePreview();
        showFinalButton.textContent = 'Show Final Result';
        finalShown = false;
      }
    });
  </script>
</Layout>

<style>
  .challenge-container {
    display: flex;
    min-height: 100vh;
    background: #1e1e1e;
  }

  .learning-panel {
