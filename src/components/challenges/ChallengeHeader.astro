---
interface Props {
  title: string;
  challengeNumber: string;
  difficulty: 'beginner' | 'intermediate' | 'advanced';
  topic: string;
  time: string;
}

const { title, challengeNumber, difficulty, topic, time } = Astro.props;
---

<div class="challenge-header">
  <div class="challenge-meta">
    <span class="challenge-number">Challenge #{challengeNumber}</span>
    <span class={`difficulty-badge ${difficulty}`}>{difficulty.charAt(0).toUpperCase() + difficulty.slice(1)}</span>
  </div>
  <h1>{title}</h1>
  <div class="challenge-info">
    <span class="topic-tag">{topic}</span>
    <span class="time-tag">{time}</span>
  </div>
</div>

<style>
  .challenge-header {
    margin-bottom: 30px;
  }

  .challenge-meta {
    display: flex;
    gap: 10px;
    margin-bottom: 15px;
  }

  .challenge-number {
    color: #858585;
    font-size: 0.9em;
  }

  .difficulty-badge {
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 0.8em;
    font-weight: 600;
  }

  .difficulty-badge.beginner {
    background: #4caf50;
    color: white;
  }

  .difficulty-badge.intermediate {
    background: #ff9800;
    color: white;
  }

  .difficulty-badge.advanced {
    background: #f44336;
    color: white;
  }

  .challenge-header h1 {
    color: #ffffff;
    font-size: 1.8em;
    margin-bottom: 10px;
  }

  .challenge-info {
    display: flex;
    gap: 10px;
  }

  .topic-tag, .time-tag {
    padding: 4px 12px;
    background: #3c3c3c;
    color: #d4d4d4;
    border-radius: 12px;
    font-size: 0.85em;
  }
</style>
