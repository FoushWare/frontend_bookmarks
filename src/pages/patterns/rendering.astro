---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Modern Web Rendering - Patterns">
  <div class="container">
    <div class="header">
      <h1>🎨 Modern Web Rendering</h1>
      <p>A reference guide covering how web rendering evolved, when to use each strategy, and the full journey a React app takes from local dev to painted pixels</p>
    </div>

    <div class="video-section">
      <h3>📹 Modern Web Rendering Overview</h3>
      <div class="video-container">
        <video controls>
          <source src="/video/Modern_Web_Rendering.mp4" type="video/mp4" />
          Your browser does not support the video tag.
        </video>
      </div>
    </div>

    <div class="content">
      <p>Content will be migrated from the archive. The original rendering pattern markdown is available in the archive folder.</p>
      <div class="links">
        <a href="/patterns" class="back-link">← Back to Patterns</a>
      </div>
    </div>

    <div class="video-section">
      <h3>📹 The Full Request Journey</h3>
      <div class="video-container">
        <video controls>
          <source src="/video/React_Request_Journey.mp4" type="video/mp4" />
          Your browser does not support the video tag.
        </video>
      </div>
    </div>
  </div>
</Layout>

<style>
  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  .header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 60px 20px;
    border-radius: 20px;
    margin-bottom: 40px;
    text-align: center;
  }

  .header h1 {
    font-size: 3em;
    margin-bottom: 15px;
  }

  .header p {
    font-size: 1.2em;
    opacity: 0.9;
  }

  .video-section {
    background: #f5f5f7;
    border-radius: 12px;
    padding: 30px;
    margin: 30px 0;
  }

  .video-section h3 {
    color: #1d1d1f;
    margin-bottom: 15px;
  }

  .video-container {
    margin: 30px 0;
    border-radius: 12px;
    overflow: hidden;
    background: #000;
  }

  .video-container video {
    width: 100%;
    display: block;
  }

  .content {
    background: white;
    border-radius: 12px;
    padding: 40px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    line-height: 1.8;
    color: #6e6e73;
  }

  .links {
    margin-top: 20px;
  }

  .back-link {
    display: inline-block;
    padding: 10px 20px;
    background: #f0f0f0;
    border-radius: 8px;
    text-decoration: none;
    color: #333;
    transition: all 0.3s;
  }

  .back-link:hover {
    background: #e0e0e0;
  }
</style>
