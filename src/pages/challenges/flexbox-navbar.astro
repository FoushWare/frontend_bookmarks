---
import Layout from '../../layouts/Layout.astro';
import ChallengeHeader from '../../components/challenges/ChallengeHeader.astro';
import ReferenceImage from '../../components/challenges/ReferenceImage.astro';
import RequirementsChecklist from '../../components/challenges/RequirementsChecklist.astro';
import LearningTips from '../../components/challenges/LearningTips.astro';
import CommonMistakes from '../../components/challenges/CommonMistakes.astro';
import HintsSystem from '../../components/challenges/HintsSystem.astro';
import StretchGoals from '../../components/challenges/StretchGoals.astro';
import FinalSolution from '../../components/challenges/FinalSolution.astro';
import ChallengeNavigation from '../../components/challenges/ChallengeNavigation.astro';
import CodeEditor from '../../components/challenges/CodeEditor.astro';
import PreviewControls from '../../components/challenges/PreviewControls.astro';
import PreviewPanel from '../../components/challenges/PreviewPanel.astro';

const starterHtml = `<nav class="navbar">
  <div class="logo">🚀 Logo</div>
  <div class="nav-links">
    <a href="#">Home</a>
    <a href="#">About</a>
    <a href="#">Services</a>
    <a href="#">Contact</a>
  </div>
  <div class="nav-actions">
    <a href="#" class="btn-login">Login</a>
    <a href="#" class="btn-signup">Sign Up</a>
  </div>
</nav>`;

const starterCss = `.navbar {
  
}

.logo {
  
}

.nav-links {
  
}

.nav-actions {
  
}

.btn-login,
.btn-signup {
  
}`;

const finalCss = `.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px;
  background: #667eea;
  color: white;
  gap: 20px;
}

.logo {
  font-size: 1.5em;
  font-weight: bold;
}

.nav-links {
  display: flex;
  gap: 20px;
}

.nav-links a {
  color: white;
  transition: opacity 0.3s;
}

.nav-links a:hover {
  opacity: 0.8;
}

.nav-actions {
  display: flex;
  gap: 10px;
}

.btn-login,
.btn-signup {
  padding: 8px 16px;
  border-radius: 6px;
  transition: background 0.3s;
}

.btn-login {
  background: transparent;
  border: 2px solid white;
  color: white;
}

.btn-login:hover {
  background: rgba(255, 255, 255, 0.1);
}

.btn-signup {
  background: white;
  color: #667eea;
}

.btn-signup:hover {
  background: #f0f0f0;
}

@media (max-width: 768px) {
  .navbar {
    flex-wrap: wrap;
  }
  
  .nav-links {
    order: 3;
    width: 100%;
    justify-content: center;
    margin-top: 20px;
  }
}`;

const requirements = [
  "Use Flexbox",
  "Space between logo and links",
  "Center items vertically",
  "Equal spacing between links",
  "Make responsive",
  "Add hover effects"
];

const hints = [
  "Which justify-content value puts elements at the edges with space between?",
  "Consider using justify-content: space-between.",
  "For vertical centering, use align-items: center.",
  "Add gap to create consistent spacing between items.",
  "Use flex-wrap for responsive behavior on mobile."
];

const tips = [
  "Think about which justify-content value creates space between elements while keeping them at the edges."
];

const mistakes = [
  { title: "Forgetting display: flex", description: "Always remember to set display: flex on the container before using flexbox properties." },
  { title: "Using margin instead of gap", description: "Modern flexbox supports the gap property for spacing between items, which is cleaner than margins." },
  { title: "Not handling mobile view", description: "Remember to use flex-wrap or media queries to handle navigation on smaller screens." }
];

const stretchGoals = [
  "Add mobile hamburger menu",
  "Create dropdown menus",
  "Add smooth scroll behavior",
  "Implement sticky positioning",
  "Add active state indicators"
];
---

<Layout title="Flexbox Navbar Challenge - Interactive Learning">
  <div class="challenge-container">
    <!-- Left Panel - Learning -->
    <aside class="learning-panel">
      <ChallengeHeader 
        title="Flexbox Navbar Challenge"
        challengeNumber="15"
        difficulty="beginner"
        topic="Flexbox"
        time="25 minutes"
      />

      <ReferenceImage title="Reference Design">
        <div class="preview-navbar">
          <div class="preview-logo">🚀 Logo</div>
          <div class="preview-links">
            <span>Home</span>
            <span>About</span>
            <span>Services</span>
            <span>Contact</span>
          </div>
          <div class="preview-actions">
            <span>Login</span>
            <span>Sign Up</span>
          </div>
        </div>
      </ReferenceImage>

      <div class="challenge-description">
        <h3>Description</h3>
        <p>Build a responsive navigation bar with a logo, navigation links, and action buttons using Flexbox. The layout should distribute space evenly and align items properly.</p>
      </div>

      <div class="learning-objectives">
        <h3>Learning Objectives</h3>
        <ul>
          <li>Understand Flexbox layout system</li>
          <li>Use justify-content for horizontal alignment</li>
          <li>Use align-items for vertical alignment</li>
          <li>Implement responsive navigation with flex-wrap</li>
        </ul>
      </div>

      <RequirementsChecklist requirements={requirements} />


      <LearningTips tips={tips} />

      <CommonMistakes mistakes={mistakes} />

      <HintsSystem hints={hints} />

      <StretchGoals goals={stretchGoals} />

      <FinalSolution finalCss={finalCss} starterCss={starterCss} />

      <ChallengeNavigation 
        previousUrl="/frontend_bookmarks/challenges/css-grid-layout"
        nextUrl="/frontend_bookmarks/challenges/grid-card-layout"
      />
    </aside>

    <!-- Right Panel - Code Editor & Preview -->
    <main class="editor-panel">
      <PreviewControls />
      <CodeEditor htmlCode={starterHtml} cssCode={starterCss} />
      <PreviewPanel />
    </main>
  </div>

  <script>
    // Live preview update
    const htmlEditor = document.getElementById('htmlEditor');
    const cssEditor = document.getElementById('cssEditor');
    const previewFrame = document.getElementById('previewFrame');

    function updatePreview() {
      const html = htmlEditor.value;
      const css = cssEditor.value;
      
      const previewContent = `
        <!DOCTYPE html>
        <html>
        <head>
          <style>
            * { margin: 0; padding: 0; box-sizing: border-box; }
            body { font-family: Arial, sans-serif; padding: 20px; }
            a { text-decoration: none; }
            ${css}
          </style>
        </head>
        <body>
          ${html}
        </body>
        </html>
      `;
      
      previewFrame.srcdoc = previewContent;
    }

    htmlEditor.addEventListener('input', updatePreview);
    cssEditor.addEventListener('input', updatePreview);

    // Initial preview
    updatePreview();
  </script>
</Layout>

<style>
  .challenge-container {
    display: flex;
    min-height: 100vh;
    background: #1e1e1e;
  }

  .learning-panel {
    width: 400px;
    background: #252526;
    padding: 30px;
    overflow-y: auto;
    border-right: 1px solid #3c3c3c;
  }

  .editor-panel {
    flex: 1;
    display: flex;
    flex-direction: column;
    background: #1e1e1e;
  }

  .image-placeholder {
    background: #2d2d2d;
    border-radius: 8px;
    padding: 20px;
    border: 2px dashed #3c3c3c;
  }

  .preview-navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px;
    background: #667eea;
    color: white;
    border-radius: 8px;
    gap: 10px;
  }

  .preview-logo {
    font-weight: bold;
  }

  .preview-links {
    display: flex;
    gap: 15px;
    font-size: 0.9em;
  }

  .preview-actions {
    display: flex;
    gap: 8px;
    font-size: 0.85em;
  }

  .challenge-description,
  .learning-objectives {
    margin-bottom: 30px;
  }

  .challenge-description h3,
  .learning-objectives h3 {
    color: #ffffff;
    margin-bottom: 15px;
  }

  .challenge-description p {
    color: #d4d4d4;
    line-height: 1.6;
  }

  .learning-objectives ul {
    list-style: none;
    padding: 0;
  }

  .learning-objectives li {
    color: #d4d4d4;
    padding: 8px 0;
    padding-left: 20px;
    position: relative;
  }

  .learning-objectives li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: #667eea;
  }

  @media (max-width: 1024px) {
    .challenge-container {
      flex-direction: column;
    }

    .learning-panel {
      width: 100%;
      max-height: 50vh;
    }

    .editor-panel {
      height: 50vh;
    }
  }
</style>
