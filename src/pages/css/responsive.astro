---
import Layout from '../../layouts/Layout.astro';
import ResourceGuide from '../../components/ResourceGuide.astro';
---

<Layout title="Responsive - CSS">
  <div class="container">
    <div class="header">
      <h1>📱 Responsive</h1>
      <p>Master responsive design and media queries</p>
    </div>

    <ResourceGuide sections={[
      {
        title: 'Practice Projects',
        icon: '🛠️',
        links: [
          {
            title: 'Responsive Projects',
            url: '/frontend_bookmarks/projects/responsive',
            description: 'Interactive coding challenges to master responsive design'
          }
        ]
      },
      {
        title: 'Gaming Practice',
        icon: '🎮',
        links: [
          {
            title: 'Flexbox Froggy',
            url: 'https://flexboxfroggy.com',
            description: 'Learn flexbox while helping a frog reach its lilypad'
          },
          {
            title: 'CSS Grid Garden',
            url: 'https://cssgridgarden.com',
            description: 'Learn grid layout while growing a carrot garden'
          }
        ]
      },
      {
        title: 'Examples & Demos',
        icon: '📚',
        links: [
          {
            title: 'Responsive Design Patterns',
            url: 'https://bradfrost.github.io/this-is-responsive/patterns.html',
            description: 'Collection of responsive design patterns'
          },
          {
            title: 'Media Queries for Standard Devices',
            url: 'https://css-tricks.com/snippets/css/media-queries-for-standard-devices',
            description: 'Common media query breakpoints'
          }
        ]
      },
      {
        title: 'References',
        icon: '📖',
        links: [
          {
            title: 'MDN Responsive Design',
            url: 'https://developer.mozilla.org/en-US/docs/Learn/CSS/CSS_layout/Responsive_Design',
            description: 'Official documentation on responsive design'
          },
          {
            title: 'Can I Use Media Queries',
            url: 'https://caniuse.com/css-mediaqueries',
            description: 'Browser compatibility information'
          }
        ]
      }
    ]} />

    <div class="content">
      <p>Responsive content will be migrated from the archive. The original files are available in the archive/CSS/Responsive folder.</p>
      <div class="links">
        <a href="/frontend_bookmarks/css" class="back-link">← Back to CSS</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  .header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 60px 20px;
    border-radius: 20px;
    margin-bottom: 40px;
    text-align: center;
  }

  .header h1 {
    font-size: 3em;
    margin-bottom: 15px;
  }

  .content {
    background: white;
    border-radius: 12px;
    padding: 40px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .links {
    margin-top: 20px;
  }

  .back-link {
    display: inline-block;
    padding: 10px 20px;
    background: #f0f0f0;
    border-radius: 8px;
    text-decoration: none;
    color: #333;
    transition: all 0.3s;
  }

  .back-link:hover {
    background: #e0e0e0;
  }
</style>
