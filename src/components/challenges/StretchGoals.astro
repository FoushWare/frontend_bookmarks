---
interface Props {
  goals: string[];
}

const { goals } = Astro.props;
---

<div class="stretch-goals">
  <h3>Stretch Goals</h3>
  <ul>
    {goals.map(goal => (
      <li>{goal}</li>
    ))}
  </ul>
</div>

<style>
  .stretch-goals {
    margin-bottom: 30px;
  }

  .stretch-goals h3 {
    color: #ffffff;
    margin-bottom: 15px;
  }

  .stretch-goals ul {
    list-style: none;
    padding: 0;
  }

  .stretch-goals li {
    color: #858585;
    padding: 8px 0;
    padding-left: 20px;
    position: relative;
  }

  .stretch-goals li::before {
    content: '★';
    position: absolute;
    left: 0;
    color: #ff9800;
  }
</style>
