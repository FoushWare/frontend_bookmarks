---
import Layout from '../../layouts/Layout.astro';
import ChallengeHeader from '../../components/challenges/ChallengeHeader.astro';
import ReferenceImage from '../../components/challenges/ReferenceImage.astro';
import RequirementsChecklist from '../../components/challenges/RequirementsChecklist.astro';
import LearningTips from '../../components/challenges/LearningTips.astro';
import CommonMistakes from '../../components/challenges/CommonMistakes.astro';
import HintsSystem from '../../components/challenges/HintsSystem.astro';
import StretchGoals from '../../components/challenges/StretchGoals.astro';
import FinalSolution from '../../components/challenges/FinalSolution.astro';
import ChallengeNavigation from '../../components/challenges/ChallengeNavigation.astro';
import CodeEditor from '../../components/challenges/CodeEditor.astro';
import PreviewControls from '../../components/challenges/PreviewControls.astro';
import PreviewPanel from '../../components/challenges/PreviewPanel.astro';

const starterHtml = `<div class="container">
  <header>Header</header>
  
  <main>
    <section class="content">Content</section>
    <aside>Sidebar</aside>
  </main>
  
  <footer>Footer</footer>
</div>`;

const starterCss = `.container {
  
}

main {
  
}

.content {
  
}

aside {
  
}

header {
  
}

footer {
  
}`;

const finalCss = `.container {
  display: grid;
  grid-template-columns: 280px 1fr;
  grid-template-rows: auto 1fr auto;
  grid-template-areas:
    "header header"
    "sidebar content"
    "footer footer";
  gap: 20px;
  min-height: 100vh;
  padding: 20px;
}

main {
  grid-area: content;
}

.content {
  background: #f0f0f0;
  padding: 20px;
}

aside {
  grid-area: sidebar;
  background: #e0e0e0;
  padding: 20px;
}

header {
  grid-area: header;
  background: #667eea;
  color: white;
  padding: 20px;
}

footer {
  grid-area: footer;
  background: #333;
  color: white;
  padding: 20px;
}

@media (max-width: 768px) {
  .container {
    grid-template-columns: 1fr;
    grid-template-areas:
      "header"
      "content"
      "sidebar"
      "footer";
  }
}`;

const requirements = [
  "Use CSS Grid",
  "Create two columns",
  "Use gap for spacing",
  "Make layout responsive",
  "Sidebar width 280px",
  "Footer spans full width",
  "Header spans full width"
];

const hints = [
  "Which layout system is better suited here? Grid or Flexbox?",
  "Consider using a two-column grid.",
  "The sidebar has a fixed width while the content grows.",
  "Think about using grid-template-columns.",
  "Remember to add spacing with gap.",
  "Align the footer across the entire page using grid-template-areas."
];

const tips = [
  "One column should remain fixed while the other expands to fill available space. Think about which CSS unit achieves this."
];

const mistakes = [
  { title: "Forgetting display: grid", description: "Always remember to set display: grid on the container before using grid properties." },
  { title: "Using Flexbox when Grid is more appropriate", description: "For two-dimensional layouts with both rows and columns, Grid is usually the better choice." },
  { title: "Incorrect use of fr units", description: "The fr unit distributes remaining space, not total space. Mix with fixed units carefully." }
];

const stretchGoals = [
  "Add dark mode support",
  "Animate hover effects",
  "Improve accessibility",
  "Add print styles",
  "Support RTL layouts"
];
---

<Layout title="CSS Grid Layout Challenge - Interactive Learning">
  <div class="challenge-container">
    <!-- Left Panel - Learning -->
    <aside class="learning-panel">
      <ChallengeHeader 
        title="CSS Grid Layout Challenge"
        challengeNumber="14"
        difficulty="intermediate"
        topic="CSS Grid"
        time="40 minutes"
      />

      <ReferenceImage title="Reference Design">
        <div class="preview-grid">
          <div class="preview-header">Header</div>
          <div class="preview-main">
            <div class="preview-content">Content</div>
            <div class="preview-sidebar">Sidebar</div>
          </div>
          <div class="preview-footer">Footer</div>
        </div>
      </ReferenceImage>

      <div class="challenge-description">
        <h3>Description</h3>
        <p>Create a responsive layout with a header, main content area, sidebar, and footer using CSS Grid. The sidebar should have a fixed width while the content area grows to fill available space.</p>
      </div>

      <div class="learning-objectives">
        <h3>Learning Objectives</h3>
        <ul>
          <li>Understand CSS Grid layout system</li>
          <li>Use grid-template-columns for column sizing</li>
          <li>Implement responsive grid layouts</li>
          <li>Use grid-template-areas for semantic layout</li>
        </ul>
      </div>

      <RequirementsChecklist requirements={requirements} />


      <LearningTips tips={tips} />

      <CommonMistakes mistakes={mistakes} />

      <HintsSystem hints={hints} />

      <StretchGoals goals={stretchGoals} />

      <FinalSolution finalCss={finalCss} starterCss={starterCss} />

      <ChallengeNavigation nextUrl="/frontend_bookmarks/challenges/flexbox-navbar" />
    </aside>

    <!-- Right Panel - Code Editor & Preview -->
    <main class="editor-panel">
      <PreviewControls />
      <CodeEditor htmlCode={starterHtml} cssCode={starterCss} />
      <PreviewPanel />
    </main>
  </div>

  <script>
    // Live preview update
    const htmlEditor = document.getElementById('htmlEditor');
    const cssEditor = document.getElementById('cssEditor');
    const previewFrame = document.getElementById('previewFrame');

    function updatePreview() {
      const html = htmlEditor.value;
      const css = cssEditor.value;
      
      const previewContent = `
        <!DOCTYPE html>
        <html>
        <head>
          <style>
            * { margin: 0; padding: 0; box-sizing: border-box; }
            body { font-family: Arial, sans-serif; padding: 20px; }
            ${css}
          </style>
        </head>
        <body>
          ${html}
        </body>
        </html>
      `;
      
      previewFrame.srcdoc = previewContent;
    }

    htmlEditor.addEventListener('input', updatePreview);
    cssEditor.addEventListener('input', updatePreview);

    // Initial preview
    updatePreview();
  </script>
</Layout>

<style>
  .challenge-container {
    display: flex;
    min-height: 100vh;
    background: #1e1e1e;
  }

  .learning-panel {
    width: 400px;
    background: #252526;
    padding: 30px;
    overflow-y: auto;
    border-right: 1px solid #3c3c3c;
  }

  .editor-panel {
    flex: 1;
    display: flex;
    flex-direction: column;
    background: #1e1e1e;
  }

  .image-placeholder {
    background: #2d2d2d;
    border-radius: 8px;
    padding: 20px;
    border: 2px dashed #3c3c3c;
  }

  .preview-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto 1fr auto;
    grid-template-areas:
      "header header"
      "content sidebar"
      "footer footer";
    gap: 10px;
    min-height: 200px;
  }

  .preview-header {
    grid-area: header;
    background: #667eea;
    color: white;
    padding: 15px;
    text-align: center;
    border-radius: 4px;
  }

  .preview-main {
    grid-area: content;
    background: #f0f0f0;
    padding: 15px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #333;
  }

  .preview-sidebar {
    grid-area: sidebar;
    background: #e0e0e0;
    padding: 15px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #333;
  }

  .preview-footer {
    grid-area: footer;
    background: #333;
    color: white;
    padding: 15px;
    text-align: center;
    border-radius: 4px;
  }

  .challenge-description,
  .learning-objectives {
    margin-bottom: 30px;
  }

  .challenge-description h3,
  .learning-objectives h3 {
    color: #ffffff;
    margin-bottom: 15px;
  }

  .challenge-description p {
    color: #d4d4d4;
    line-height: 1.6;
  }

  .learning-objectives ul {
    list-style: none;
    padding: 0;
  }

  .learning-objectives li {
    color: #d4d4d4;
    padding: 8px 0;
    padding-left: 20px;
    position: relative;
  }

  .learning-objectives li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: #667eea;
  }

  @media (max-width: 1024px) {
    .challenge-container {
      flex-direction: column;
    }

    .learning-panel {
      width: 100%;
      max-height: 50vh;
    }

    .editor-panel {
      height: 50vh;
    }
  }
</style>
