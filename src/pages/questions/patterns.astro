---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Design Patterns Interview Questions - Learning Hub">
  <div class="container">
    <div class="header">
      <h1>🧩 Design Patterns Questions</h1>
      <p>Master design patterns, rendering patterns, and architectural patterns</p>
    </div>

    <div class="markdown-content">
      <p>Design patterns interview questions content will be added here.</p>
    </div>

    <div class="links">
      <a href="/questions" class="back-link">← Back to Questions</a>
    </div>
  </div>
</Layout>

<style>
  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  .header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 60px 20px;
    border-radius: 20px;
    margin-bottom: 40px;
    text-align: center;
  }

  .header h1 {
    font-size: 3em;
    margin-bottom: 15px;
  }

  .markdown-content {
    background: white;
    border-radius: 12px;
    padding: 40px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    line-height: 1.8;
    color: #2c3e50;
    max-width: 900px;
    margin: 0 auto;
  }

  .markdown-content h2 {
    font-size: 2em;
    color: #34495e;
    margin: 25px 0 15px 0;
    padding-bottom: 8px;
    border-bottom: 1px solid #e9ecef;
  }

  .markdown-content h3 {
    font-size: 1.5em;
    color: #34495e;
    margin: 20px 0 10px 0;
  }

  .markdown-content p {
    margin: 15px 0;
  }

  .markdown-content code {
    background: #f8f9fa;
    padding: 2px 6px;
    border-radius: 4px;
    font-family: 'Courier New', monospace;
    font-size: 0.9em;
    color: #e74c3c;
  }

  .markdown-content details {
    margin: 15px 0;
    padding: 15px;
    background: #f8f9fa;
    border-radius: 8px;
    border-left: 4px solid #667eea;
  }

  .markdown-content summary {
    cursor: pointer;
    font-weight: 600;
    color: #667eea;
  }

  .markdown-content hr {
    border: none;
    border-top: 2px solid #e9ecef;
    margin: 30px 0;
  }

  .links {
    margin-top: 20px;
    text-align: center;
  }

  .back-link {
    display: inline-block;
    padding: 10px 20px;
    background: #f0f0f0;
    border-radius: 8px;
    text-decoration: none;
    color: #333;
    transition: all 0.3s;
  }

  .back-link:hover {
    background: #e0e0e0;
  }
</style>
