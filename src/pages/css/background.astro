---
import Layout from '../../layouts/Layout.astro';
import ResourceGuide from '../../components/ResourceGuide.astro';
---

<Layout title="Background - CSS">
  <div class="container">
    <div class="header">
      <h1>🖼️ Background</h1>
      <p>Master background properties and techniques</p>
    </div>

    <ResourceGuide sections={[
      {
        title: 'Practice Projects',
        icon: '🛠️',
        links: [
          {
            title: 'Background Projects',
            url: '/projects/background',
            description: 'Interactive coding challenges to master backgrounds'
          }
        ]
      },
      {
        title: 'Gaming Practice',
        icon: '🎮',
        links: [
          {
            title: 'CSS Gradient Generator',
            url: 'https://cssgradient.io',
            description: 'Interactive tool to learn CSS gradients'
          },
          {
            title: 'Pattern Generator',
            url: 'https://bennettfeely.com/clippy',
            description: 'Learn clip-path and background patterns'
          }
        ]
      },
      {
        title: 'Examples & Demos',
        icon: '📚',
        links: [
          {
            title: 'CSS-Tricks Background Guide',
            url: 'https://css-tricks.com/almanac/properties/b/background',
            description: 'Comprehensive guide to background properties'
          },
          {
            title: 'CSS Gradient Patterns',
            url: 'https://lea.verou.me/css3patterns',
            description: 'Collection of CSS gradient patterns'
          }
        ]
      },
      {
        title: 'References',
        icon: '📖',
        links: [
          {
            title: 'MDN Background Documentation',
            url: 'https://developer.mozilla.org/en-US/docs/Web/CSS/background',
            description: 'Official documentation on background properties'
          },
          {
            title: 'Can I Use Background',
            url: 'https://caniuse.com/background-img-opts',
            description: 'Browser compatibility information'
          }
        ]
      }
    ]} />

    <div class="content">
      <p>Background content will be migrated from the archive. The original files are available in the archive/CSS/Background folder.</p>
      <div class="links">
        <a href="/css" class="back-link">← Back to CSS</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  .header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 60px 20px;
    border-radius: 20px;
    margin-bottom: 40px;
    text-align: center;
  }

  .header h1 {
    font-size: 3em;
    margin-bottom: 15px;
  }

  .content {
    background: white;
    border-radius: 12px;
    padding: 40px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .links {
    margin-top: 20px;
  }

  .back-link {
    display: inline-block;
    padding: 10px 20px;
    background: #f0f0f0;
    border-radius: 8px;
    text-decoration: none;
    color: #333;
    transition: all 0.3s;
  }

  .back-link:hover {
    background: #e0e0e0;
  }
</style>
