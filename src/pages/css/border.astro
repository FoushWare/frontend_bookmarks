---
import Layout from '../../layouts/Layout.astro';
import ResourceGuide from '../../components/ResourceGuide.astro';
---

<Layout title="Border - CSS">
  <div class="container">
    <div class="header">
      <h1>🔲 Border</h1>
      <p>Master border properties and styling</p>
    </div>

    <ResourceGuide sections={[
      {
        title: 'Practice Projects',
        icon: '🛠️',
        links: [
          {
            title: 'Border Projects',
            url: '/frontend_bookmarks/projects/border',
            description: 'Interactive coding challenges to master borders'
          }
        ]
      },
      {
        title: 'Gaming Practice',
        icon: '🎮',
        links: [
          {
            title: 'CSS Gradient Generator',
            url: 'https://cssgradient.io',
            description: 'Learn border-radius with gradient tools'
          },
          {
            title: 'Border Radius Generator',
            url: 'https://border-radius.com',
            description: 'Interactive border-radius generator'
          }
        ]
      },
      {
        title: 'Examples & Demos',
        icon: '📚',
        links: [
          {
            title: 'CSS-Tricks Border Guide',
            url: 'https://css-tricks.com/almanac/properties/b/border',
            description: 'Comprehensive guide to border properties'
          },
          {
            title: 'Border Radius Tricks',
            url: 'https://css-tricks.com/snippets/css/border-radius',
            description: 'Creative border-radius techniques'
          }
        ]
      },
      {
        title: 'References',
        icon: '📖',
        links: [
          {
            title: 'MDN Border Documentation',
            url: 'https://developer.mozilla.org/en-US/docs/Web/CSS/border',
            description: 'Official documentation on border properties'
          },
          {
            title: 'Can I Use Border Radius',
            url: 'https://caniuse.com/border-radius',
            description: 'Browser compatibility information'
          }
        ]
      }
    ]} />

    <div class="content">
      <p>Border content will be migrated from the archive. The original files are available in the archive/CSS/Border folder.</p>
      <div class="links">
        <a href="/frontend_bookmarks/css" class="back-link">← Back to CSS</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  .header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 60px 20px;
    border-radius: 20px;
    margin-bottom: 40px;
    text-align: center;
  }

  .header h1 {
    font-size: 3em;
    margin-bottom: 15px;
  }

  .content {
    background: white;
    border-radius: 12px;
    padding: 40px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .links {
    margin-top: 20px;
  }

  .back-link {
    display: inline-block;
    padding: 10px 20px;
    background: #f0f0f0;
    border-radius: 8px;
    text-decoration: none;
    color: #333;
    transition: all 0.3s;
  }

  .back-link:hover {
    background: #e0e0e0;
  }
</style>
