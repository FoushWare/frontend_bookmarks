---
import Layout from '../../../layouts/Layout.astro';
import ProjectWorkspace from '../../../components/ProjectWorkspace';
import { flexboxProjects } from '../../../data/flexbox-projects';
import type { Project } from '../../../types/project';

export function getStaticPaths() {
  return flexboxProjects.map((project) => ({
    params: { id: project.id },
  }));
}

const { id } = Astro.params;
const project = flexboxProjects.find(p => p.id === id);

if (!project) {
  return Astro.redirect('/frontend_bookmarks/projects/flexbox');
}
---

<Layout title={`${project.title} - Flexbox Project`}>
  <div class="project-page">
    <ProjectWorkspace client:load project={project} />
  </div>
</Layout>

<style>
  .project-page {
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px 20px;
  }
</style>
