---
interface Props {
  requirements: string[];
}

const { requirements } = Astro.props;
---

<div class="requirements-section">
  <h3>Requirements</h3>
  <div class="progress-bar">
    <div class="progress-fill" style="width: 0%"></div>
  </div>
  <div class="progress-text">0 / {requirements.length} completed (0%)</div>
  <div class="requirements-list">
    {requirements.map((req, index) => (
      <label class="requirement-item">
        <input type="checkbox" data-index={index} />
        <span>{req}</span>
      </label>
    ))}
  </div>
</div>

<style>
  .requirements-section {
    margin-bottom: 30px;
  }

  .requirements-section h3 {
    color: #ffffff;
    margin-bottom: 15px;
  }

  .progress-bar {
    height: 8px;
    background: #3c3c3c;
    border-radius: 4px;
    margin-bottom: 10px;
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #667eea, #764ba2);
    transition: width 0.3s ease;
  }

  .progress-text {
    color: #858585;
    font-size: 0.9em;
    margin-bottom: 15px;
  }

  .requirements-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .requirement-item {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #d4d4d4;
    cursor: pointer;
  }

  .requirement-item input {
    accent-color: #667eea;
  }
</style>

<script>
  // Requirements checklist logic
  const requirementItems = document.querySelectorAll('.requirement-item input');
  const progressFill = document.querySelector('.progress-fill') as HTMLElement | null;
  const progressText = document.querySelector('.progress-text') as HTMLElement | null;

  requirementItems.forEach(item => {
    item.addEventListener('change', () => {
      const checked = document.querySelectorAll('.requirement-item input:checked').length;
      const total = requirementItems.length;
      const percentage = Math.round((checked / total) * 100);
      
      if (progressFill) progressFill.style.width = percentage + '%';
      if (progressText) progressText.textContent = `${checked} / ${total} completed (${percentage}%)`;
    });
  });
</script>
