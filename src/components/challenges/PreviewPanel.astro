---

<div class="preview-section">
  <h3>Live Preview</h3>
  <div class="preview-container" id="previewContainer">
    <iframe id="previewFrame" class="preview-frame"></iframe>
  </div>
</div>

<style>
  .preview-section {
    flex: 1;
    display: flex;
    flex-direction: column;
    background: #ffffff;
  }

  .preview-section h3 {
    padding: 15px 30px;
    background: #f5f5f5;
    border-bottom: 1px solid #e0e0e0;
    color: #333;
    margin: 0;
  }

  .preview-container {
    flex: 1;
    padding: 30px;
    background: #f5f5f5;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    overflow: auto;
    transition: max-width 0.3s ease;
  }

  .preview-frame {
    width: 100%;
    height: 100%;
    border: none;
    background: white;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }
</style>
