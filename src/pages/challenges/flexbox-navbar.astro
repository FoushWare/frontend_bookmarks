    background: #3c3c3c;
    color: #d4d4d4;
    border-radius: 12px;
    font-size: 0.85em;
  }

  .reference-image {
    margin-bottom: 30px;
  }

  .reference-image h3 {
    color: #ffffff;
    margin-bottom: 15px;
  }

  .image-placeholder {
    background: #2d2d2d;
    border-radius: 8px;
    padding: 20px;
    border: 2px dashed #3c3c3c;
  }

  .preview-navbar {
    display: flex;
    justify-content: space-between;
