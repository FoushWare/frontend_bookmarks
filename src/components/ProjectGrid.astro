---
import type { Project } from '../types/project';

interface Props {
  projects: Project[];
  basePath: string;
}

const { projects, basePath } = Astro.props;
---

<div class="project-grid">
  {projects.map((project) => (
    <a href={`${basePath}/${project.id}`} class="project-card">
      <div class="card-icon">
        {project.difficulty === 'beginner' && '🟢'}
        {project.difficulty === 'intermediate' && '🟡'}
        {project.difficulty === 'advanced' && '🔴'}
      </div>
      <h2>{project.title}</h2>
      <p>{project.expectedResult}</p>
      <div class="card-meta">
        <span class={`difficulty-badge ${project.difficulty}`}>
          {project.difficulty.charAt(0).toUpperCase() + project.difficulty.slice(1)}
        </span>
        <span class="test-count">{project.tests.length} tests</span>
      </div>
    </a>
  ))}
</div>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 25px;
    margin-bottom: 40px;
  }

  .project-card {
    background: white;
    border-radius: 12px;
    padding: 30px;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
    border: 2px solid transparent;
  }

  .project-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    border-color: #667eea;
  }

  .card-icon {
    font-size: 2em;
    margin-bottom: 15px;
  }

  .project-card h2 {
    font-size: 1.5em;
    margin-bottom: 10px;
    color: #333;
  }

  .project-card p {
    color: #666;
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .card-meta {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .difficulty-badge {
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 0.85em;
    font-weight: 600;
  }

  .difficulty-badge.beginner {
    background: #4caf50;
    color: white;
  }

  .difficulty-badge.intermediate {
    background: #ff9800;
    color: white;
  }

  .difficulty-badge.advanced {
    background: #f44336;
    color: white;
  }

  .test-count {
    padding: 4px 12px;
    background: #f5f5f5;
    color: #666;
    border-radius: 12px;
    font-size: 0.85em;
  }

  @media (max-width: 768px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
