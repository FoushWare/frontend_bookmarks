---
interface Props {
  title: string;
  challengeNumber: string;
  difficulty: 'beginner' | 'intermediate' | 'advanced';
  topic: string;
  time: string;
  learningPanel: any;
  editorPanel: any;
}

const { 
  title, 
  challengeNumber, 
  difficulty, 
  topic, 
  time,
  learningPanel,
  editorPanel
} = Astro.props;
---

<div class="challenge-container">
  <!-- Left Panel - Learning -->
  <aside class="learning-panel">
    <slot name="learning-panel" />
  </aside>

  <!-- Right Panel - Code Editor & Preview -->
  <main class="editor-panel">
    <slot name="editor-panel" />
  </main>
</div>

<style>
  .challenge-container {
    display: flex;
    min-height: 100vh;
    background: #1e1e1e;
  }

  .learning-panel {
    width: 400px;
    background: #252526;
    padding: 30px;
    overflow-y: auto;
    border-right: 1px solid #3c3c3c;
  }

  .editor-panel {
    flex: 1;
    display: flex;
    flex-direction: column;
    background: #1e1e1e;
  }

  @media (max-width: 1024px) {
    .challenge-container {
      flex-direction: column;
    }

    .learning-panel {
      width: 100%;
      max-height: 50vh;
    }

    .editor-panel {
      height: 50vh;
    }
  }
</style>
