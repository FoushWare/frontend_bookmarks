---
import Layout from '../../layouts/Layout.astro';
import ResourceGuide from '../../components/ResourceGuide.astro';
---

<Layout title="Typography - CSS">
  <div class="container">
    <div class="header">
      <h1>🔤 Typography</h1>
      <p>Master fonts, text styling, and typography</p>
    </div>

    <ResourceGuide sections={[
      {
        title: 'Practice Projects',
        icon: '🛠️',
        links: [
          {
            title: 'Typography Projects',
            url: '/projects/typography',
            description: 'Interactive coding challenges to master typography'
          }
        ]
      },
      {
        title: 'Gaming Practice',
        icon: '🎮',
        links: [
          {
            title: 'Type Method',
            url: 'https://typemethod.com',
            description: 'Learn typography through interactive exercises'
          },
          {
            title: 'Kern Type',
            url: 'http://kerntype.method.ac',
            description: 'Learn kerning through a game'
          }
        ]
      },
      {
        title: 'Examples & Demos',
        icon: '📚',
        links: [
          {
            title: 'CSS-Tricks Typography Guide',
            url: 'https://css-tricks.com/complete-guide-to-typography',
            description: 'Comprehensive guide to web typography'
          },
          {
            title: 'Web Font Loader',
            url: 'https://github.com/typekit/webfontloader',
            description: 'Web font loading library and examples'
          }
        ]
      },
      {
        title: 'References',
        icon: '📖',
        links: [
          {
            title: 'MDN Typography Documentation',
            url: 'https://developer.mozilla.org/en-US/docs/Learn/CSS/Styling_text',
            description: 'Official documentation on text styling'
          },
          {
            title: 'Google Fonts',
            url: 'https://fonts.google.com',
            description: 'Free web fonts library'
          }
        ]
      }
    ]} />

    <div class="content">
      <p>Typography content will be migrated from the archive. The original files are available in the archive/CSS/Typography folder.</p>
      <div class="links">
        <a href="/css" class="back-link">← Back to CSS</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  .header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 60px 20px;
    border-radius: 20px;
    margin-bottom: 40px;
    text-align: center;
  }

  .header h1 {
    font-size: 3em;
    margin-bottom: 15px;
  }

  .content {
    background: white;
    border-radius: 12px;
    padding: 40px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .links {
    margin-top: 20px;
  }

  .back-link {
    display: inline-block;
    padding: 10px 20px;
    background: #f0f0f0;
    border-radius: 8px;
    text-decoration: none;
    color: #333;
    transition: all 0.3s;
  }

  .back-link:hover {
    background: #e0e0e0;
  }
</style>
