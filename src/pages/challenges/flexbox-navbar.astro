  .size-button.active {
    background: #667eea;
    color: white;
  }

  .size-button:hover:not(.active) {
    background: #4c4c4c;
  }

  .editor-section {
    flex: 1;
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid #3c3c3c;
  }

  .editor-tabs {
    display: flex;
    background: #252526;
    border-bottom: 1px solid #3c3c3c;
  }

  .tab-button {
