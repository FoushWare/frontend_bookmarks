---
import Layout from '../../layouts/Layout.astro';
import ResourceGuide from '../../components/ResourceGuide.astro';
---

<Layout title="Spacing - CSS">
  <div class="container">
    <div class="header">
      <h1>📏 Spacing</h1>
      <p>Master padding, margin, and spacing techniques</p>
    </div>

    <ResourceGuide sections={[
      {
        title: 'Practice Projects',
        icon: '🛠️',
        links: [
          {
            title: 'Spacing Projects',
            url: '/frontend_bookmarks/projects/spacing',
            description: 'Interactive coding challenges to master spacing'
          }
        ]
      },
      {
        title: 'Gaming Practice',
        icon: '🎮',
        links: [
          {
            title: 'Flexbox Froggy',
            url: 'https://flexboxfroggy.com',
            description: 'Learn spacing through flexbox layout'
          },
          {
            title: 'CSS Grid Garden',
            url: 'https://cssgridgarden.com',
            description: 'Learn spacing through grid layout'
          }
        ]
      },
      {
        title: 'Examples & Demos',
        icon: '📚',
        links: [
          {
            title: 'CSS-Tricks Spacing Guide',
            url: 'https://css-tricks.com/fun-hacks-margin-collapsing',
            description: 'Understanding margin collapsing and spacing'
          },
          {
            title: 'Modern CSS Spacing',
            url: 'https://web.dev/learn/css/margin',
            description: 'Modern spacing techniques'
          }
        ]
      },
      {
        title: 'References',
        icon: '📖',
        links: [
          {
            title: 'MDN Spacing Documentation',
            url: 'https://developer.mozilla.org/en-US/docs/Web/CSS/CSS_Box_Model/Margin_collapsing',
            description: 'Official documentation on spacing'
          },
          {
            title: 'Can I Use Gap',
            url: 'https://caniuse.com/flexbox-gap',
            description: 'Browser compatibility for gap property'
          }
        ]
      }
    ]} />

    <div class="content">
      <p>Spacing content will be migrated from the archive. The original files are available in the archive/CSS/Spacing folder.</p>
      <div class="links">
        <a href="/frontend_bookmarks/css" class="back-link">← Back to CSS</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  .header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 60px 20px;
    border-radius: 20px;
    margin-bottom: 40px;
    text-align: center;
  }

  .header h1 {
    font-size: 3em;
    margin-bottom: 15px;
  }

  .content {
    background: white;
    border-radius: 12px;
    padding: 40px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .links {
    margin-top: 20px;
  }

  .back-link {
    display: inline-block;
    padding: 10px 20px;
    background: #f0f0f0;
    border-radius: 8px;
    text-decoration: none;
    color: #333;
    transition: all 0.3s;
  }

  .back-link:hover {
    background: #e0e0e0;
  }
</style>
