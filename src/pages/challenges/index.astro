---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="CSS Challenges - Interactive Learning">
  <div class="container">
    <div class="header">
      <h1>🎯 CSS Layout Challenges</h1>
      <p>Master CSS Grid and Flexbox through hands-on interactive challenges</p>
    </div>

    <div class="challenges-grid">
      <a href="/challenges/css-grid-layout" class="challenge-card">
        <div class="challenge-number">#14</div>
        <div class="challenge-icon">🔲</div>
        <h3>CSS Grid Layout</h3>
        <p>Create a responsive layout with header, content, sidebar, and footer using CSS Grid</p>
        <div class="challenge-meta">
          <span class="difficulty-badge intermediate">Intermediate</span>
          <span class="time-badge">40 min</span>
          <span class="topic-badge">CSS Grid</span>
        </div>
        <div class="challenge-skills">
          <span class="skill">grid-template-columns</span>
          <span class="skill">grid-template-areas</span>
          <span class="skill">Responsive Design</span>
        </div>
      </a>

      <a href="/challenges/flexbox-navbar" class="challenge-card">
        <div class="challenge-number">#15</div>
        <div class="challenge-icon">📦</div>
        <h3>Flexbox Navbar</h3>
        <p>Build a responsive navigation bar with logo, links, and action buttons using Flexbox</p>
        <div class="challenge-meta">
          <span class="difficulty-badge beginner">Beginner</span>
          <span class="time-badge">25 min</span>
          <span class="topic-badge">Flexbox</span>
        </div>
        <div class="challenge-skills">
          <span class="skill">justify-content</span>
          <span class="skill">align-items</span>
          <span class="skill">flex-wrap</span>
        </div>
      </a>

      <a href="/challenges/grid-card-layout" class="challenge-card">
        <div class="challenge-number">#16</div>
        <div class="challenge-icon">🔲</div>
        <h3>Responsive Card Grid</h3>
        <p>Create a responsive card layout that adapts from mobile to desktop using CSS Grid</p>
        <div class="challenge-meta">
          <span class="difficulty-badge intermediate">Intermediate</span>
          <span class="time-badge">35 min</span>
          <span class="topic-badge">CSS Grid</span>
        </div>
        <div class="challenge-skills">
          <span class="skill">auto-fit</span>
          <span class="skill">minmax</span>
          <span class="skill">Media Queries</span>
        </div>
      </a>

      <a href="/challenges/flexbox-centering" class="challenge-card">
        <div class="challenge-number">#17</div>
        <div class="challenge-icon">📦</div>
        <h3>Perfect Centering</h3>
        <p>Master the art of centering content both horizontally and vertically using Flexbox</p>
        <div class="challenge-meta">
          <span class="difficulty-badge beginner">Beginner</span>
          <span class="time-badge">20 min</span>
          <span class="topic-badge">Flexbox</span>
        </div>
        <div class="challenge-skills">
          <span class="skill">justify-content</span>
          <span class="skill">align-items</span>
          <span class="skill">min-height</span>
        </div>
      </a>

      <a href="/challenges/grid-dashboard" class="challenge-card">
        <div class="challenge-number">#18</div>
        <div class="challenge-icon">🔲</div>
        <h3>Dashboard Layout</h3>
        <p>Build a complex dashboard with sidebar, header, widgets, and footer using CSS Grid</p>
        <div class="challenge-meta">
          <span class="difficulty-badge advanced">Advanced</span>
          <span class="time-badge">60 min</span>
          <span class="topic-badge">CSS Grid</span>
        </div>
        <div class="challenge-skills">
          <span class="skill">grid-template-areas</span>
          <span class="skill">Nested Grids</span>
          <span class="skill">Complex Layouts</span>
        </div>
      </a>

      <a href="/challenges/flexbox-gallery" class="challenge-card">
        <div class="challenge-number">#19</div>
        <div class="challenge-icon">📦</div>
        <h3>Image Gallery</h3>
        <p>Create a responsive image gallery with uniform spacing using Flexbox</p>
        <div class="challenge-meta">
          <span class="difficulty-badge intermediate">Intermediate</span>
          <span class="time-badge">30 min</span>
          <span class="topic-badge">Flexbox</span>
        </div>
        <div class="challenge-skills">
          <span class="skill">flex-wrap</span>
          <span class="skill">gap</span>
          <span class="skill">flex-basis</span>
        </div>
      </a>

      <div class="challenge-card coming-soon">
        <div class="challenge-number">#20</div>
        <div class="challenge-icon">🔲</div>
        <h3>Grid Masonry Layout</h3>
        <p>Create a Pinterest-style masonry layout using CSS Grid</p>
        <div class="challenge-meta">
          <span class="difficulty-badge advanced">Advanced</span>
          <span class="time-badge">45 min</span>
          <span class="topic-badge">CSS Grid</span>
        </div>
        <div class="coming-soon-badge">Coming Soon</div>
      </div>

      <div class="challenge-card coming-soon">
        <div class="challenge-number">#21</div>
        <div class="challenge-icon">📦</div>
        <h3>Flexbox Form Layout</h3>
        <p>Build a responsive form with proper alignment using Flexbox</p>
        <div class="challenge-meta">
          <span class="difficulty-badge intermediate">Intermediate</span>
          <span class="time-badge">30 min</span>
          <span class="topic-badge">Flexbox</span>
        </div>
        <div class="coming-soon-badge">Coming Soon</div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  .header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 60px 20px;
    border-radius: 20px;
    margin-bottom: 40px;
    text-align: center;
  }

  .header h1 {
    font-size: 3em;
    margin-bottom: 15px;
  }

  .header p {
    font-size: 1.2em;
    opacity: 0.9;
  }

  .challenges-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 30px;
  }

  .challenge-card {
    background: white;
    border-radius: 16px;
    padding: 30px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s, box-shadow 0.3s;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    border: 1px solid #e5e5e5;
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .challenge-card:hover:not(.coming-soon) {
    transform: translateY(-5px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .challenge-card.coming-soon {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .challenge-number {
    position: absolute;
    top: 20px;
    right: 20px;
    font-size: 0.9em;
    color: #858585;
    font-weight: 600;
  }

  .challenge-icon {
    font-size: 3em;
    margin-bottom: 15px;
  }

  .challenge-card h3 {
    font-size: 1.5em;
    margin-bottom: 10px;
    color: #1d1d1f;
  }

  .challenge-card p {
    color: #6e6e73;
    line-height: 1.6;
    margin-bottom: 20px;
    flex: 1;
  }

  .challenge-meta {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 15px;
  }

  .difficulty-badge,
  .time-badge,
  .topic-badge {
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 0.85em;
    font-weight: 600;
  }

  .difficulty-badge.beginner {
    background: #d4edda;
    color: #155724;
  }

  .difficulty-badge.intermediate {
    background: #fff3cd;
    color: #856404;
  }

  .difficulty-badge.advanced {
    background: #f8d7da;
    color: #721c24;
  }

  .time-badge {
    background: #e3f2fd;
    color: #1976d2;
  }

  .topic-badge {
    background: #f3e5f5;
    color: #7b1fa2;
  }

  .challenge-skills {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .skill {
    padding: 4px 10px;
    background: #f5f5f5;
    color: #6e6e73;
    border-radius: 12px;
    font-size: 0.8em;
  }

  .coming-soon-badge {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: rgba(0, 0, 0, 0.8);
    color: white;
    padding: 10px 20px;
    border-radius: 8px;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .header h1 {
      font-size: 2em;
    }

    .challenges-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
