    padding: 15px;
    background: #667eea;
    color: white;
    border-radius: 8px;
    gap: 10px;
  }

  .preview-logo {
    font-weight: bold;
  }

  .preview-links {
    display: flex;
    gap: 15px;
    font-size: 0.9em;
  }

  .preview-actions {
    display: flex;
    gap: 8px;
    font-size: 0.85em;
  }

  .challenge-description,
  .learning-objectives,
  .requirements-section,
  .learning-tips,
  .common-mistakes,
  .hints-section,
  .stretch-goals,
  .final-solution,
