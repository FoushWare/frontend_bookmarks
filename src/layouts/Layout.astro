---
import ThemeToggle from '../components/ThemeToggle';
import Logo from '../components/Logo';
import MobileMenuToggle from '../components/MobileMenuToggle';
import NavLinks from '../components/NavLinks';
import '../styles.css';

interface Props {
  title?: string;
}

const { title = 'Learning Hub' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="stylesheet" href="/frontend_bookmarks/theme.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-bg-primary text-text-primary transition-colors duration-300 font-sans text-base leading-relaxed antialiased">
    <nav class="fixed top-0 left-0 right-0 bg-bg-primary/90 backdrop-blur-lg shadow-md z-50 py-3 transition-all duration-300">
      <div class="flex justify-between items-center px-5 max-w-[1400px] mx-auto">
        <a href="/frontend_bookmarks/" class="text-[1.4em] font-bold text-primary-600 no-underline flex items-center gap-3 whitespace-nowrap -tracking-[0.5px]">
          <Logo client:load />
          <span class="bg-gradient-to-br from-primary-600 to-slate-800 dark:from-primary-500 dark:to-slate-900 bg-clip-text text-transparent font-bold">Learning Hub</span>
        </a>
        <MobileMenuToggle client:load />
        <NavLinks client:load />
        <NavLinks client:load isMobile />
        <ThemeToggle client:load />
      </div>
    </nav>

    <main class="pt-20">
      <slot />
    </main>
  </body>
</html>
