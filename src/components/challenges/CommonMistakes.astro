---
interface Props {
  mistakes: { title: string; description: string }[];
}

const { mistakes } = Astro.props;
---

<div class="common-mistakes">
  <h3>Common Mistakes</h3>
  {mistakes.map(mistake => (
    <details class="mistake-card">
      <summary>{mistake.title}</summary>
      <p>{mistake.description}</p>
    </details>
  ))}
</div>

<style>
  .common-mistakes {
    margin-bottom: 30px;
  }

  .common-mistakes h3 {
    color: #ffffff;
    margin-bottom: 15px;
  }

  .mistake-card {
    background: #2d2d2d;
    padding: 15px;
    border-radius: 8px;
    margin-bottom: 10px;
    cursor: pointer;
  }

  .mistake-card summary {
    color: #d4d4d4;
    font-weight: 500;
  }

  .mistake-card p {
    color: #858585;
    margin-top: 10px;
    line-height: 1.6;
  }
</style>
